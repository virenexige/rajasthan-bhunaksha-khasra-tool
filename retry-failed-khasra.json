te = state;\n        pendingGisCode = gisCode;\n        pendingPlotNo = plotNo;\n        pendingSameOwner = sameOwner;\n        generateCaptcha();\n        var modal = document.getElementById('captchaModal');\n        if (modal) {\n            modal.style.display = 'block';\n        }\n    }\n    \n    function closeCaptcha() {\n        var modal = document.getElementById('captchaModal');\n        if (modal) {\n            modal.style.display = 'none';\n        }\n        var errorMsg = document.getElementById('captchaError');\n        if (errorMsg) {\n            errorMsg.innerHTML = '';\n        }\n        var captchaInput = document.getElementById('captchaInput');\n        if (captchaInput) {\n            captchaInput.value = '';\n        }\n    }\n    \n    function verifyCaptcha() {\n        var userInput = document.getElementById('captchaInput').value;\n        if (userInput === currentCaptcha) {\n            var url = '08/plotreportRJ.jsp?state=' + pendingState + '&giscode=' + pendingGisCode + '&plotno=' + pendingPlotNo;\n            if (pendingSameOwner === 'Y') {\n                url += '&sameownerplotreport=Y';\n            }\n            window.open(url, '_blank');\n            closeCaptcha();\n        } else {\n            var errorMsg = document.getElementById('captchaError');\n            if (errorMsg) {\n                errorMsg.innerHTML = '❌ Invalid captcha! Please try again.';\n            }\n            refreshCaptcha();\n        }\n    }\n    \n    window.onclick = function(event) {\n        var modal = document.getElementById('captchaModal');\n        if (event.target === modal) {\n            closeCaptcha();\n        }\n    }\n</script>\n",
